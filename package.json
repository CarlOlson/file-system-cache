{
  "name": "file-system-cache",
  "version": "3.0.0",
  "description": "A super-fast, promise-based cache that reads and writes to the file-system.",
  "keywords": [
    "cache",
    "fs",
    "file-system"
  ],
  "homepage": "https://github.com/philcockfield/file-system-cache",
  "repository": {
    "type": "git",
    "url": "https://github.com/philcockfield/file-system-cache"
  },
  "license": "MIT",
  "author": {
    "name": "Phil Cockfield",
    "email": "phil@cockfield.net",
    "url": "https://github.com/philcockfield"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.mjs",
  "files": [
    "README.md",
    "lib/**"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --clean --minify --dts --out-dir lib",
    "format": "prettier ./src --write",
    "gen:hashtype": "node ./script.ts/generate-hashtype.ts",
    "prepublish": "npm test && npm run build",
    "test": "node --test src/test/*.TEST.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ramda": "^0.30.1",
    "prettier": "^3.3.3",
    "ramda": "^0.30.1",
    "tsdown": "^0.22.0",
    "typescript": "^6"
  },
  "packageManager": "yarn@1.22.19+sha512.ff4579ab459bb25aa7c0ff75b62acebe576f6084b36aa842971cf250a5d8c6cd3bc9420b22ce63c7f93a0857bc6ef29291db39c3e7a23aab5adfd5a4dd6c5d71"
}
