{
  "name": "file-system-cache",
  "version": "3.0.0",
  "description": "A super-fast, promise-based cache that reads and writes to the file-system.",
  "keywords": [
    "cache",
    "fs",
    "file-system"
  ],
  "homepage": "https://github.com/philcockfield/file-system-cache",
  "repository": {
    "type": "git",
    "url": "https://github.com/philcockfield/file-system-cache"
  },
  "license": "MIT",
  "author": {
    "name": "Phil Cockfield",
    "email": "phil@cockfield.net",
    "url": "https://github.com/philcockfield"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/FileSystemCache.d.mts",
      "import": "./lib/FileSystemCache.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/FileSystemCache.mjs",
  "files": [
    "README.md",
    "lib/**"
  ],
  "scripts": {
    "build": "tsdown src/FileSystemCache.ts --clean --minify --dts --out-dir lib",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "lint": "tsc && biome lint",
    "prepublish": "npm test && npm run build",
    "test": "node --test src/test/*.TEST.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^24",
    "mitata": "^1.0.34",
    "tsdown": "^0.22.0",
    "typescript": "^6"
  },
  "packageManager": "yarn@4.14.1"
}
